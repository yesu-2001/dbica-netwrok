{
  "entities": {
    "StaffMember": {
      "title": "StaffMember",
      "description": "Faculty or administrative staff user account, role, credentials, and leave entitlements",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique staff identifier (e.g. DIR001, HR001)" },
        "userId": { "type": "string", "description": "User login identifier or username" },
        "name": { "type": "string", "description": "Full name of staff member" },
        "email": { "type": "string", "format": "email", "description": "Institutional email address" },
        "phone": { "type": "string", "description": "Contact phone or WhatsApp number" },
        "department": { "type": "string", "description": "Academic or operational department name" },
        "role": { "type": "string", "enum": ["Super Admin", "HR", "Manager", "Staff"], "description": "Access control role" },
        "designation": { "type": "string", "description": "Academic designation or job title" },
        "portalPassword": { "type": "string", "description": "Portal authentication credential" },
        "status": { "type": "string", "enum": ["Active", "Inactive"], "description": "Account status" },
        "joinedDate": { "type": "string", "description": "Date of joining in YYYY-MM-DD" },
        "avatarBg": { "type": "string", "description": "Avatar background color class" },
        "reportingTo": { "type": "string", "description": "Staff ID of supervisor or department head" }
      },
      "required": ["id", "name", "email", "role", "department", "status"]
    },
    "LeaveRequest": {
      "title": "LeaveRequest",
      "description": "Leave application document filed by a faculty or staff member",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique leave request ID" },
        "staffId": { "type": "string", "description": "Staff ID of the applicant" },
        "staffName": { "type": "string", "description": "Applicant full name" },
        "staffEmail": { "type": "string", "format": "email", "description": "Applicant email" },
        "department": { "type": "string", "description": "Applicant department" },
        "leaveType": { "type": "string", "enum": ["Casual", "Sick", "Compensatory", "Permission", "Leave Without Pay (LWP)", "Earned"], "description": "Category of leave" },
        "startDate": { "type": "string", "description": "Leave start date YYYY-MM-DD" },
        "endDate": { "type": "string", "description": "Leave end date YYYY-MM-DD" },
        "totalDays": { "type": "number", "description": "Working days requested" },
        "permissionMinutes": { "type": "number", "description": "Duration in minutes for monthly permission" },
        "permissionStartTime": { "type": "string", "description": "Start time for permission" },
        "permissionEndTime": { "type": "string", "description": "End time for permission" },
        "workedDate": { "type": "string", "description": "Date previously worked for compensatory leave" },
        "workedHours": { "type": "number", "description": "Extra hours previously worked" },
        "workedDutyDetails": { "type": "string", "description": "Duties performed during extra time worked" },
        "workedPeriodType": { "type": "string", "description": "Timing context of extra work: after office hours, holiday, weekend" },
        "compensatoryLeaveDate": { "type": "string", "description": "Date for which compensatory leave is claimed" },
        "reason": { "type": "string", "description": "Reason for leave" },
        "emergencyContact": { "type": "string", "description": "Emergency telephone contact" },
        "status": { "type": "string", "enum": ["Pending", "Approved", "Rejected", "Cancelled"], "description": "Current status" },
        "actionedBy": { "type": "string", "description": "Name or role of approving or rejecting officer" },
        "actionedAt": { "type": "string", "description": "Timestamp of status update" },
        "rejectionReason": { "type": "string", "description": "Reason provided if rejected" },
        "appliedAt": { "type": "string", "description": "Timestamp when application was submitted" }
      },
      "required": ["id", "staffId", "leaveType", "startDate", "endDate", "totalDays", "status", "appliedAt"]
    },
    "DepartmentItem": {
      "title": "DepartmentItem",
      "description": "Academic or operational department at DBICA",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Department code or ID" },
        "name": { "type": "string", "description": "Display name of the department" },
        "code": { "type": "string", "description": "Short abbreviation code" },
        "description": { "type": "string", "description": "Description of department scope" },
        "hodId": { "type": "string", "description": "Staff ID of the Head of Department" },
        "createdAt": { "type": "string", "description": "Creation timestamp" },
        "updatedAt": { "type": "string", "description": "Last modified timestamp" }
      },
      "required": ["id", "name", "code", "createdAt"]
    },
    "GlobalSettings": {
      "title": "GlobalSettings",
      "description": "Institutional leave quota thresholds and policies",
      "type": "object",
      "properties": {
        "casual": { "type": "number", "description": "Annual casual leave entitlement" },
        "sick": { "type": "number", "description": "Annual sick leave entitlement" },
        "earned": { "type": "number", "description": "Annual earned leave entitlement" },
        "compensatoryMax": { "type": "number", "description": "Max allowed compensatory leaves" },
        "updatedAt": { "type": "string", "description": "Last updated timestamp" },
        "updatedBy": { "type": "string", "description": "Actor who last updated the configuration" }
      },
      "required": ["casual", "sick", "earned", "updatedAt", "updatedBy"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Tamper-proof system audit and activity event record",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Audit record ID" },
        "timestamp": { "type": "string", "description": "ISO timestamp of event" },
        "actorId": { "type": "string", "description": "Staff ID of actor" },
        "actorName": { "type": "string", "description": "Name of actor" },
        "actorRole": { "type": "string", "description": "Role of actor" },
        "action": { "type": "string", "description": "Action performed" },
        "details": { "type": "string", "description": "Detailed description of action" },
        "targetId": { "type": "string", "description": "ID of targeted record if any" }
      },
      "required": ["id", "timestamp", "actorId", "actorName", "action", "details"]
    },
    "NotificationLog": {
      "title": "NotificationLog",
      "description": "Dispatched email and WhatsApp notification logs",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Notification log ID" },
        "recipientName": { "type": "string", "description": "Name of the recipient" },
        "recipientEmail": { "type": "string", "description": "Recipient email address" },
        "recipientPhone": { "type": "string", "description": "Recipient phone or WhatsApp number" },
        "channel": { "type": "string", "enum": ["email", "whatsapp", "both"], "description": "Communication channel" },
        "type": { "type": "string", "description": "Event trigger type" },
        "subject": { "type": "string", "description": "Subject or title of notification" },
        "message": { "type": "string", "description": "Dispatched message content" },
        "status": { "type": "string", "enum": ["dispatched", "delivered", "failed", "pending"], "description": "Dispatch status" },
        "timestamp": { "type": "string", "description": "Dispatch timestamp" },
        "referenceId": { "type": "string", "description": "Associated leave request or staff ID" }
      },
      "required": ["id", "channel", "type", "message", "status", "timestamp"]
    }
  },
  "firestore": {
    "/staff/{staffId}": {
      "schema": "StaffMember",
      "description": "Faculty and staff user profiles, roles, passwords, and leave entitlements"
    },
    "/leaveRequests/{requestId}": {
      "schema": "LeaveRequest",
      "description": "Submitted leave applications and approval statuses"
    },
    "/departments/{departmentId}": {
      "schema": "DepartmentItem",
      "description": "Academic and operational departments"
    },
    "/settings/{settingId}": {
      "schema": "GlobalSettings",
      "description": "System-wide leave threshold settings and policies"
    },
    "/auditLogs/{logId}": {
      "schema": "AuditLog",
      "description": "Immutable security and activity audit records"
    },
    "/notifications/{notificationId}": {
      "schema": "NotificationLog",
      "description": "Dispatched email and WhatsApp confirmations and acknowledgements"
    }
  }
}
