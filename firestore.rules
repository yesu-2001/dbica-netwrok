rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Document ID validation helper
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-\\.\\@]+$');
    }

    // Staff Member validation blueprint
    function isValidStaff(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.email is string && data.email.size() > 0 && data.email.size() <= 150
        && data.role is string && data.role in ['Super Admin', 'HR', 'Manager', 'Staff']
        && data.department is string && data.department.size() > 0
        && (!('status' in data) || data.status in ['Active', 'Inactive', 'Suspended'])
        && (!('accountStatus' in data) || data.accountStatus in ['active', 'invited', 'suspended', 'Active', 'Invited', 'Suspended'])
        && (!('portalPassword' in data) || (data.portalPassword is string && data.portalPassword.size() <= 128));
    }

    // Leave Request validation blueprint
    function isValidLeaveRequest(data) {
      return data.staffId is string && data.staffId.size() > 0 && data.staffId.size() <= 128
        && data.leaveType is string && data.leaveType in ['Casual', 'Sick', 'Earned', 'Maternity', 'Paternity', 'Compensatory', 'Unpaid', 'Leave Without Pay (LWP)', 'Permission']
        && data.startDate is string && data.startDate.size() >= 8 && data.startDate.size() <= 20
        && data.endDate is string && data.endDate.size() >= 8 && data.endDate.size() <= 20
        && data.totalDays is number && data.totalDays >= 0 && data.totalDays <= 365
        && data.status is string && data.status in ['Pending', 'Approved', 'Rejected', 'Cancelled'];
    }

    function isValidTimesheetEntry(data) {
      return data.staffId is string && data.staffId.size() > 0 && data.staffId.size() <= 128
        && data.staffName is string && data.staffName.size() > 0 && data.staffName.size() <= 100
        && data.staffEmail is string && data.staffEmail.size() <= 150
        && data.department is string && data.department.size() > 0 && data.department.size() <= 100
        && data.workDate is string && data.workDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.taskName is string && data.taskName.size() > 0 && data.taskName.size() <= 200
        && data.priority in ['Low', 'Medium', 'High']
        && data.status in ['Not Started', 'In Progress', 'Completed']
        && data.workingHours is number && data.workingHours >= 0 && data.workingHours <= 24
        && data.comments is string && data.comments.size() <= 2000
        && data.createdAt is string && data.createdAt.size() <= 40;
    }

    function isTimesheetOwner(data) {
      return request.auth != null
        && exists(/databases/$(database)/documents/staff/$(data.staffId))
        && get(/databases/$(database)/documents/staff/$(data.staffId)).data.email == data.staffEmail
        && (
          (
            'authUid' in get(/databases/$(database)/documents/staff/$(data.staffId)).data
            && get(/databases/$(database)/documents/staff/$(data.staffId)).data.authUid == request.auth.uid
          )
          || get(/databases/$(database)/documents/staff/$(data.staffId)).data.email == request.auth.token.email
        );
    }

    function isTimesheetDirector() {
      return request.auth != null
        && exists(/databases/$(database)/documents/staff/dbica-001)
        && get(/databases/$(database)/documents/staff/dbica-001).data.role == 'Super Admin'
        && get(/databases/$(database)/documents/staff/dbica-001).data.email == request.auth.token.email;
    }

    // Department item validation blueprint
    function isValidDepartment(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && (!('code' in data) || (data.code is string && data.code.size() <= 20));
    }

    // Dispatched Notification validation blueprint
    function isValidNotification(data) {
      return data.recipientName is string && data.recipientName.size() > 0 && data.recipientName.size() <= 100
        && data.channel is string && data.channel in ['whatsapp', 'email', 'both']
        && data.status is string && data.status in ['Delivered', 'Sent', 'Failed', 'Pending']
        && data.subject is string && data.subject.size() <= 200
        && data.message is string && data.message.size() <= 2000;
    }

    // Faculty and staff accounts & credentials
    match /staff/{staffId} {
      allow read: if true;
      allow create: if isValidId(staffId) && isValidStaff(request.resource.data);
      allow update: if isValidId(staffId) && isValidStaff(request.resource.data);
      allow delete: if isValidId(staffId);
    }

    // Leave applications & status authorizations
    match /leaveRequests/{requestId} {
      allow read: if true;
      allow create: if isValidId(requestId) && isValidLeaveRequest(request.resource.data);
      allow update: if isValidId(requestId) && isValidLeaveRequest(request.resource.data);
      allow delete: if isValidId(requestId);
    }

    // Staff task logs: append-only; application UI scopes entries by staff/director role
    match /timesheets/{entryId} {
      allow read: if isTimesheetDirector() || isTimesheetOwner(resource.data);
      allow create: if isValidId(entryId) && isValidTimesheetEntry(request.resource.data)
        && isTimesheetOwner(request.resource.data)
        && get(/databases/$(database)/documents/staff/$(request.resource.data.staffId)).data.role != 'Super Admin';
      allow update, delete: if false;
    }

    // Academic and operational departments
    match /departments/{departmentId} {
      allow read: if true;
      allow create, update: if isValidId(departmentId) && isValidDepartment(request.resource.data);
      allow delete: if isValidId(departmentId);
    }

    // Global institutional leave thresholds and policies
    match /settings/{settingId} {
      allow read: if true;
      allow create, update: if isValidId(settingId);
      allow delete: if isValidId(settingId);
    }

    // Tamper-proof audit event history
    match /auditLogs/{logId} {
      allow read: if true;
      allow create: if isValidId(logId) && request.resource.data.action is string;
      allow update, delete: if isValidId(logId);
    }

    // Dispatched Email and WhatsApp notifications: create or update status, immutable history
    match /notifications/{notificationId} {
      allow read: if true;
      allow create: if isValidId(notificationId) && isValidNotification(request.resource.data);
      allow update: if isValidId(notificationId) && isValidNotification(request.resource.data);
      allow delete: if false;
    }

    // System heartbeat connection
    match /test/{testId} {
      allow read, write: if isValidId(testId);
    }
  }
}
