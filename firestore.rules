rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Document ID validation helper
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-\\.\\@]+$');
    }

    // Staff Member validation blueprint
    function isValidStaff(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.email is string && data.email.size() > 0 && data.email.size() <= 150
        && data.role is string && data.role in ['Super Admin', 'HR', 'Manager', 'Staff']
        && data.department is string && data.department.size() > 0
        && (!('status' in data) || data.status in ['Active', 'Inactive', 'Suspended'])
        && (!('accountStatus' in data) || data.accountStatus in ['active', 'invited', 'suspended', 'Active', 'Invited', 'Suspended'])
        && (!('portalPassword' in data) || (data.portalPassword is string && data.portalPassword.size() <= 128));
    }

    // Leave Request validation blueprint
    function isValidLeaveRequest(data) {
      return data.staffId is string && data.staffId.size() > 0 && data.staffId.size() <= 128
        && data.leaveType is string && data.leaveType in ['Casual', 'Sick', 'Earned', 'Maternity', 'Paternity', 'Compensatory', 'Unpaid', 'Leave Without Pay (LWP)', 'Permission']
        && data.startDate is string && data.startDate.size() >= 8 && data.startDate.size() <= 20
        && data.endDate is string && data.endDate.size() >= 8 && data.endDate.size() <= 20
        && data.totalDays is number && data.totalDays >= 0 && data.totalDays <= 365
        && data.status is string && data.status in ['Pending', 'Approved', 'Rejected', 'Cancelled']
        && (!('actionedBy' in data) || (data.actionedBy is string && data.actionedBy.size() <= 150))
        && (!('actionedAt' in data) || (data.actionedAt is string && data.actionedAt.size() <= 40))
        && (!('rejectionReason' in data) || (data.rejectionReason is string && data.rejectionReason.size() <= 2000));
    }

    function isValidTimesheetEntry(data) {
      return data.staffId is string && data.staffId.size() > 0 && data.staffId.size() <= 128
        && data.staffName is string && data.staffName.size() > 0 && data.staffName.size() <= 100
        && data.staffEmail is string && data.staffEmail.size() <= 150
        && data.department is string && data.department.size() > 0 && data.department.size() <= 100
        && data.workDate is string && data.workDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.taskName is string && data.taskName.size() > 0 && data.taskName.size() <= 200
        && data.priority in ['Low', 'Medium', 'High']
        && data.status in ['Not Started', 'In Progress', 'Completed']
        && data.workingHours is number && data.workingHours >= 0 && data.workingHours <= 24
        && data.comments is string && data.comments.size() <= 2000
        && data.createdAt is string && data.createdAt.size() <= 40;
    }

    function hasAttendanceAccess() {
      return request.auth != null
        && exists(/databases/$(database)/documents/attendanceAccess/$(request.auth.uid))
        && get(/databases/$(database)/documents/attendanceAccess/$(request.auth.uid)).data.enabled == true;
    }

    function isPrimaryAdmin() {
      return request.auth != null && request.auth.token.email == 'director@dbica.org';
    }

    function isSuperAdmin() {
      return isPrimaryAdmin()
        || (hasAttendanceAccess()
          && get(/databases/$(database)/documents/attendanceAccess/$(request.auth.uid)).data.role == 'Super Admin');
    }

    function isHR() {
      return hasAttendanceAccess()
        && get(/databases/$(database)/documents/attendanceAccess/$(request.auth.uid)).data.role == 'HR';
    }

    function isOwnStaffProfileUpdate(staffId) {
      return hasAttendanceAccess()
        && get(/databases/$(database)/documents/attendanceAccess/$(request.auth.uid)).data.staffId == staffId
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'name', 'phone', 'department', 'designation', 'portalPassword',
            'failedLoginAttempts', 'lockoutUntil', 'lastLoginAt'
          ])
        && (
          get(/databases/$(database)/documents/attendanceAccess/$(request.auth.uid)).data.role != 'Manager'
          || request.resource.data.department == resource.data.department
        );
    }

    function isTimesheetOwner(data) {
      return request.auth != null
        && exists(/databases/$(database)/documents/staff/$(data.staffId))
        && get(/databases/$(database)/documents/staff/$(data.staffId)).data.role != 'Super Admin'
        && (
          (
            'authUid' in get(/databases/$(database)/documents/staff/$(data.staffId)).data
            && get(/databases/$(database)/documents/staff/$(data.staffId)).data.authUid == request.auth.uid
          )
          || (
            get(/databases/$(database)/documents/staff/$(data.staffId)).data.email == data.staffEmail
            && get(/databases/$(database)/documents/staff/$(data.staffId)).data.email == request.auth.token.email
          )
        );
    }

    function canReadAllAttendance() {
      return isPrimaryAdmin()
        || (hasAttendanceAccess()
          && get(/databases/$(database)/documents/attendanceAccess/$(request.auth.uid)).data.role in ['Super Admin', 'HR']);
    }

    function canReadOwnOrDepartmentAttendance(data) {
      return request.auth != null
        && hasAttendanceAccess()
        && (
          data.staffId == get(/databases/$(database)/documents/attendanceAccess/$(request.auth.uid)).data.staffId
          || (
            get(/databases/$(database)/documents/attendanceAccess/$(request.auth.uid)).data.role == 'Manager'
            && data.department == get(/databases/$(database)/documents/attendanceAccess/$(request.auth.uid)).data.department
          )
        );
    }

    function isLeaveOwner(data) {
      return request.auth != null
        && exists(/databases/$(database)/documents/staff/$(data.staffId))
        && get(/databases/$(database)/documents/staff/$(data.staffId)).data.email == data.staffEmail
        && (
          (
            'authUid' in get(/databases/$(database)/documents/staff/$(data.staffId)).data
            && get(/databases/$(database)/documents/staff/$(data.staffId)).data.authUid == request.auth.uid
          )
          || get(/databases/$(database)/documents/staff/$(data.staffId)).data.email == request.auth.token.email
        );
    }

    // Department item validation blueprint
    function isValidDepartment(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && (!('code' in data) || (data.code is string && data.code.size() <= 20));
    }

    // Dispatched Notification validation blueprint
    function isValidNotification(data) {
      return data.recipientName is string && data.recipientName.size() > 0 && data.recipientName.size() <= 100
        && data.channel is string && data.channel in ['whatsapp', 'email', 'both']
        && data.status is string && data.status in ['Delivered', 'Sent', 'Failed', 'Pending']
        && data.subject is string && data.subject.size() <= 200
        && data.message is string && data.message.size() <= 2000;
    }

    // Faculty and staff accounts & credentials
    match /staff/{staffId} {
      allow read: if true;
      allow create: if isValidId(staffId)
        && isValidStaff(request.resource.data)
        && (
          isSuperAdmin()
          || (isHR() && request.resource.data.role != 'Super Admin')
        );
      allow update: if isValidId(staffId)
        && isValidStaff(request.resource.data)
        && (
          isSuperAdmin()
          || (
            isHR()
            && resource.data.role != 'Super Admin'
            && request.resource.data.role != 'Super Admin'
          )
          || isOwnStaffProfileUpdate(staffId)
          || request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['failedLoginAttempts', 'lockoutUntil'])
        );
      allow delete: if isValidId(staffId) && isSuperAdmin();
    }

    // Leave applications & status authorizations
    match /leaveRequests/{requestId} {
      allow read: if request.auth != null;
      allow create: if isValidId(requestId)
        && isValidLeaveRequest(request.resource.data)
        && isLeaveOwner(request.resource.data);
      allow update: if request.auth != null
        && isValidId(requestId)
        && isValidLeaveRequest(request.resource.data)
        && request.resource.data.staffId == resource.data.staffId
        && request.resource.data.staffEmail == resource.data.staffEmail
        && request.resource.data.department == resource.data.department
        && request.resource.data.leaveType == resource.data.leaveType
        && request.resource.data.startDate == resource.data.startDate
        && request.resource.data.endDate == resource.data.endDate
        && request.resource.data.totalDays == resource.data.totalDays
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'actionedBy', 'actionedAt', 'rejectionReason']);
      allow delete: if false;
    }

    // Staff can manage only their own task logs; directors have read-only access.
    match /timesheets/{entryId} {
      allow read: if true;
      allow create: if isValidId(entryId) && isValidTimesheetEntry(request.resource.data) && isTimesheetOwner(request.resource.data);
      allow update: if isValidTimesheetEntry(request.resource.data)
        && isTimesheetOwner(resource.data)
        && request.resource.data.staffId == resource.data.staffId
        && request.resource.data.staffEmail == resource.data.staffEmail
        && request.resource.data.staffName == resource.data.staffName
        && request.resource.data.department == resource.data.department
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isTimesheetOwner(resource.data);
    }

    // Attendance authorization is maintained by the trusted sync service.
    match /attendanceAccess/{authUid} {
      allow read, write: if false;
    }

    match /daily_attendance/{attendanceId} {
      allow read: if canReadAllAttendance() || canReadOwnOrDepartmentAttendance(resource.data);
      allow write: if false;
    }

    match /monthly_summary/{summaryId} {
      allow read: if canReadAllAttendance() || canReadOwnOrDepartmentAttendance(resource.data);
      allow write: if false;
    }

    // Academic and operational departments
    match /departments/{departmentId} {
      allow read: if true;
      allow create, update: if isValidId(departmentId) && isValidDepartment(request.resource.data);
      allow delete: if isValidId(departmentId);
    }

    // Global institutional leave thresholds and policies
    match /settings/{settingId} {
      allow read: if true;
      allow create, update: if isValidId(settingId);
      allow delete: if isValidId(settingId);
    }

    // Tamper-proof audit event history
    match /auditLogs/{logId} {
      allow read: if true;
      allow create: if isValidId(logId) && request.resource.data.action is string;
      allow update, delete: if isValidId(logId);
    }

    // Dispatched Email and WhatsApp notifications: create or update status, immutable history
    match /notifications/{notificationId} {
      allow read: if true;
      allow create: if isValidId(notificationId) && isValidNotification(request.resource.data);
      allow update: if isValidId(notificationId) && isValidNotification(request.resource.data);
      allow delete: if false;
    }

    // System heartbeat connection
    match /test/{testId} {
      allow read, write: if isValidId(testId);
    }
  }
}
